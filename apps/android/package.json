{
  "name": "@projectplant/android",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --workspace-root --filter @projectplant/web-ui run dev -- --host 0.0.0.0 --port 5173",
    "run": "cap run android -l --external",
    "build": "pnpm --workspace-root --filter @projectplant/web-ui run build && cap build android",
    "sync": "pnpm --workspace-root --filter @projectplant/web-ui run build && cap sync android",
    "open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@projectplant/native-bridge": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "typescript": "^5.5.4"
  }
}
