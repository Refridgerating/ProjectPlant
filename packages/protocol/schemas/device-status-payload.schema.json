{
  "$id": "https://projectplant.local/schemas/device-status-payload.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeviceStatusPayload",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "potId": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "minLength": 1 },
    "fwVersion": { "type": "string" },
    "requestId": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "timestampMs": { "type": "integer", "minimum": 0 },
    "timestamp_ms": { "type": "integer", "minimum": 0 },
    "pumpOn": { "type": "boolean" },
    "pump_on": { "type": "boolean" },
    "pump": { "anyOf": [{ "type": "boolean" }, { "type": "string", "enum": ["on", "off"] }] },
    "icZone1On": { "type": "boolean" },
    "ic_zone1_on": { "type": "boolean" },
    "icZone1": { "anyOf": [{ "type": "boolean" }, { "type": "string", "enum": ["on", "off"] }] },
    "ic_zone1": { "anyOf": [{ "type": "boolean" }, { "type": "string", "enum": ["on", "off"] }] },
    "fanOn": { "type": "boolean" },
    "fan_on": { "type": "boolean" },
    "fan": { "anyOf": [{ "type": "boolean" }, { "type": "string", "enum": ["on", "off"] }] },
    "misterOn": { "type": "boolean" },
    "mister_on": { "type": "boolean" },
    "mister": { "anyOf": [{ "type": "boolean" }, { "type": "string", "enum": ["on", "off"] }] },
    "lightOn": { "type": "boolean" },
    "light_on": { "type": "boolean" },
    "light": { "anyOf": [{ "type": "boolean" }, { "type": "string", "enum": ["on", "off"] }] },
    "deviceName": { "type": "string" },
    "displayName": { "type": "string" },
    "isNamed": { "type": "boolean" },
    "sensorMode": { "type": "string" },
    "sensor_mode": { "type": "string" },
    "schedule": { "$ref": "device-schedule-payload.schema.json" },
    "schedulePaused": { "type": "boolean" },
    "schedulePausedUntilMs": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "scheduleUpdatedAtMs": { "type": "integer", "minimum": 0 },
    "scheduleTimezonePosix": { "type": "string" },
    "schedule_timezone_posix": { "type": "string" },
    "tzOffsetMinutesCurrent": { "type": "integer" },
    "tz_offset_minutes_current": { "type": "integer" }
  },
  "anyOf": [
    { "required": ["status"] },
    { "required": ["state"] },
    { "required": ["requestId"] },
    { "required": ["request_id"] },
    { "required": ["pumpOn"] },
    { "required": ["pump_on"] },
    { "required": ["pump"] },
    { "required": ["icZone1On"] },
    { "required": ["ic_zone1_on"] },
    { "required": ["fanOn"] },
    { "required": ["fan_on"] },
    { "required": ["misterOn"] },
    { "required": ["mister_on"] },
    { "required": ["lightOn"] },
    { "required": ["light_on"] },
    { "required": ["deviceName"] },
    { "required": ["displayName"] },
    { "required": ["sensorMode"] },
    { "required": ["sensor_mode"] },
    { "required": ["schedule"] },
    { "required": ["scheduleTimezonePosix"] },
    { "required": ["tzOffsetMinutesCurrent"] },
    { "required": ["timestamp"] },
    { "required": ["timestampMs"] }
  ]
}
