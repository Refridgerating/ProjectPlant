{
  "$id": "https://projectplant.local/schemas/device-schedule-payload.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeviceSchedulePayload",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "light": { "$ref": "#/definitions/timer" },
    "pump": { "$ref": "#/definitions/timer" },
    "icZone1": { "$ref": "#/definitions/timer" },
    "ic_zone1": { "$ref": "#/definitions/timer" },
    "mister": { "$ref": "#/definitions/timer" },
    "fan": { "$ref": "#/definitions/timer" },
    "tzOffsetMinutes": { "type": "integer" },
    "scheduleTimezonePosix": { "type": "string", "minLength": 1 },
    "scheduleUpdatedAtMs": { "type": "integer", "minimum": 0 },
    "updatedAtMs": { "type": "integer", "minimum": 0 }
  },
  "definitions": {
    "timer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "startTime", "endTime"],
      "properties": {
        "enabled": { "type": "boolean" },
        "startTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "endTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
      }
    }
  }
}
